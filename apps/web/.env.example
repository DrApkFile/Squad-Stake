DATABASE_URL=postgresql://user:password@localhost:5432/squad_stake
# Optional; Neon's direct (non-PgBouncer) endpoint. `pnpm db:migrate` prefers it and falls
# back to DATABASE_URL. The Vercel + Neon Marketplace integration sets both.
DATABASE_URL_UNPOOLED=
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_NIMIQ_NETWORK=mainnet
# Optional; works only with next dev, never with a production build.
DEV_HARNESS=0
